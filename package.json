{
  "name": "toolnexus-web",
  "version": "0.8.0",
  "description": "Run LLMs in the browser — GPU or CPU, same API. Tool calling, embeddings, RAG, offline knowledge bundles, and metrics. Hooks-style TypeScript over Transformers.js (injectable).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "default": "./dist/chat.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./rag": {
      "types": "./dist/rag.d.ts",
      "default": "./dist/rag.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    },
    "./toolcalls": {
      "types": "./dist/toolcalls.d.ts",
      "default": "./dist/toolcalls.js"
    },
    "./archive": {
      "types": "./dist/archive.d.ts",
      "default": "./dist/archive.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "default": "./dist/bundle.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "default": "./dist/source.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:models": "node scripts/model-matrix.mjs",
    "test:rag": "node scripts/rag-matrix.mjs",
    "docs:verified": "node scripts/gen-verified-page.mjs"
  },
  "keywords": [
    "webgpu",
    "rag",
    "knowledge-base",
    "llm",
    "browser",
    "wasm",
    "onnx",
    "tool-calling",
    "rag",
    "embeddings",
    "transformers.js",
    "offline",
    "cpu"
  ],
  "author": "Muthukumaran Navaneethakrishnan <muthuishere@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muthuishere/toolnexus-web.git"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "fflate": "^0.8.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.5.0",
    "fflate": ">=0.8.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "fflate": {
      "optional": true
    }
  },
  "homepage": "https://github.com/muthuishere/toolnexus-web",
  "bugs": {
    "url": "https://github.com/muthuishere/toolnexus-web/issues"
  }
}
