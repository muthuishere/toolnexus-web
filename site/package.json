{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild": "node scripts/copy-demo.mjs",
    "predev": "node -e \"const fs=require('fs');fs.mkdirSync('public/demo',{recursive:true});for(const f of ['index.html','coi.js','jev-snake.html'])fs.copyFileSync('../examples/'+f,'public/demo/'+f);console.log('copied examples/{index.html,coi.js,jev-snake.html} -> site/public/demo/')\""
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "@fontsource-variable/inter": "^5.2.8",
    "astro": "^7.0.2",
    "sharp": "^0.34.5",
    "starlight-llms-txt": "^0.11.0"
  }
}
